{
  "manifest_version": 3,
  "name": "Music & Lyric Collector",
  "version": "2.0",
  "description": "Bắt link MP3, trích xuất lời bài hát kèm timestamp, tải về 1 file ZIP trọn gói cho mỗi bài.",
  "permissions": [
    "webRequest",
    "storage",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tải Nhạc & Lyric"
  }
}
